import numpy as np
import pandas as pd
import gensim.downloader as api
from sklearn.linear_model import LogisticRegression

print("Carregando modelo de Embeddings...")

fasttext_model = api.load("glove-wiki-gigaword-50")

print("Modelo carregado com sucesso!")

def obter_vetor_frase(frase, model):
    """
    Transforma uma frase em um único vetor utilizando
    Mean Pooling (média dos vetores das palavras).
    """

    palavras = frase.split()
    vetores = []

    for palavra in palavras:

        if palavra in model:
            # TODO 1:
            # Adicionar o vetor da palavra na lista
            vetores.append(model[palavra])

    if len(vetores) == 0:

        # Se nenhuma palavra estiver no vocabulário,
        # retorna um vetor de zeros.
        return np.zeros(model.vector_size)

    # TODO 2:
    # Calcular a média dos vetores
    vetor_medio = np.mean(vetores, axis=0)

    return vetor_medio

df = pd.read_csv("sac_moveis_ac2.csv")

print("\nColunas do dataset:")

for coluna in df.columns:
    print("-", coluna)

# A coluna "mensagem" contém o texto.
# A outra coluna normalmente contém a intenção.

colunas_possiveis_target = [
    "intencao",
    "intenção",
    "intent",
    "classe",
    "classificacao",
    "classificação"
]

coluna_target = None

for coluna in colunas_possiveis_target:

    if coluna in df.columns:
        coluna_target = coluna
        break


if coluna_target is None:

    raise ValueError(
        "Não foi possível encontrar a coluna de intenção. "
        "Verifique o nome da coluna no CSV."
    )


y = df[coluna_target]

print("\nColuna utilizada como target:", coluna_target)
print("\nDistribuição das intenções:")
print(y.value_counts())

X_vetores = np.array([
    obter_vetor_frase(msg, fasttext_model)
    for msg in df["mensagem"]
])

print("\nFormato da matriz X:")
print(X_vetores.shape)

modelo_regressao = LogisticRegression(
    max_iter=1000
)

modelo_regressao.fit(X_vetores, y)

print("\nModelo de Regressão Logística treinado com sucesso!")
print("\nClasses identificadas:")
print(modelo_regressao.classes_)

def classificar_com_fallback_linear(
    mensagem_usuario,
    modelo,
    model_emb,
    limiar=0.50
):
    """
    Classifica uma mensagem e aplica uma regra de fallback.

    Se a maior probabilidade for menor que o limiar,
    a mensagem será encaminhada para atendimento humano.

    Retorna:
        (intenção, confiança)
    """

    # --------------------------------------------------------
    # 1. Transformar a mensagem em vetor
    # --------------------------------------------------------

    vetor_msg = obter_vetor_frase(
        mensagem_usuario,
        model_emb
    ).reshape(1, -1)


    # --------------------------------------------------------
    # TODO 1:
    # Obter as probabilidades de cada classe
    # --------------------------------------------------------

    probabilidades = modelo.predict_proba(vetor_msg)[0]


    # --------------------------------------------------------
    # TODO 2:
    # Encontrar a maior probabilidade
    # --------------------------------------------------------

    max_prob = np.max(probabilidades)


    # Encontrar o índice da classe correspondente

    idx_classe = np.argmax(probabilidades)


    # Obter o nome da intenção

    intencao_prevista = modelo.classes_[idx_classe]


    # --------------------------------------------------------
    # TODO 3:
    # Aplicar a regra de fallback
    # --------------------------------------------------------

    if max_prob < limiar:

        return "FALLBACK_HUMANO", max_prob

    else:

        return intencao_prevista, max_prob


testes = [

    "Quero saber o valor do frete do sofá",

    "Gostaria de ver receitas de bolo de cenoura"

]


for t in testes:

    intencao, conf = classificar_com_fallback_linear(
        t,
        modelo_regressao,
        fasttext_model,
        limiar=0.50
    )

    print("-" * 70)

    print(f"Frase: {t}")

    print(f"Resultado: {intencao}")

    print(f"Confiança: {conf:.2%}")