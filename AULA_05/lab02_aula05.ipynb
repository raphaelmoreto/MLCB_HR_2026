import numpy as np
import pandas as pd
import gensim.downloader as api

df = pd.read_csv("sac_moveis_ac2.csv")

print("=" * 60)
print("DATASET CARREGADO COM SUCESSO")
print("=" * 60)

print("Quantidade de registros:", len(df))

print("\nColunas disponíveis:")
print(df.columns.tolist())

print("\nPrimeiras linhas:")
display(df.head())

if "mensagem" not in df.columns:
    raise ValueError(
        "A coluna 'mensagem' não foi encontrada no arquivo "
        "'sac_moveis_ac2.csv'."
    )

print("\n" + "=" * 60)
print("CARREGANDO MODELO DE EMBEDDINGS")
print("=" * 60)

print("Modelo: glove-wiki-gigaword-50")
print("A primeira execução pode levar alguns minutos...")

glove_model = api.load("glove-wiki-gigaword-50")

print("\nModelo carregado com sucesso!")
print("Dimensão dos vetores:", glove_model.vector_size)

def obter_vetor_frase(frase, model):

    # Garantir que a entrada seja texto
    frase = str(frase)

    # Converter para letras minúsculas.
    # O vocabulário do GloVe possui palavras em minúsculas.
    frase = frase.lower()

    # Separar a frase em palavras
    palavras = frase.split()

    # Lista que armazenará os vetores encontrados
    vetores = []

    # Percorrer cada palavra
    for palavra in palavras:

        # Verificar se a palavra existe no vocabulário
        if palavra in model:

            # TODO 1:
            # Adicionar o vetor da palavra à lista
            vetores.append(model[palavra])

    # Se nenhuma palavra estiver no vocabulário,
    # retornar um vetor de zeros
    if len(vetores) == 0:
        return np.zeros(model.vector_size, dtype=np.float32)

    # TODO 2:
    # Calcular a média dos vetores no eixo 0
    vetor_medio = np.mean(vetores, axis=0)

    return vetor_medio

X_vetores = np.array([
    obter_vetor_frase(msg, glove_model)
    for msg in df["mensagem"]
])

print("\n" + "=" * 60)
print("RESULTADO DO MEAN POOLING")
print("=" * 60)

print(
    "Formato da Matriz de Vetores Densos "
    "(Exemplos, Dimensões):",
    X_vetores.shape
)

print("Quantidade de mensagens:", X_vetores.shape[0])
print("Dimensão de cada vetor:", X_vetores.shape[1])

if len(X_vetores) > 0:

    print("\nExemplo do primeiro vetor:")
    print(X_vetores[0])

    print("\nPrimeiras 10 dimensões do primeiro vetor:")
    print(X_vetores[0][:10])

else:
    print("\nO dataset não possui registros.")